# Enable URL rewriting for Apache.
RewriteEngine On

# Adjust if the app runs in a subdirectory, e.g. RewriteBase /backend/public/
RewriteBase /

# Route all requests that are not existing files/dirs/symlinks
# to the front controller.
RewriteCond %{REQUEST_FILENAME} !-l
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule .* index.php [L,QSA]
